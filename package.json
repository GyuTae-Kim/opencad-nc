{
  "name": "opencad-nc",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCAD NC 뷰어·해석기: G-code·Heidenhain·woodWOP MPR·WangShi PGI·KDT XML 프로그램을 브라우저에서 읽어 3D 공구 경로로 보여 줌",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./view/vlist.css": "./src/view/vlist.css",
    "./*": "./src/*.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "vite --port 4401",
    "build": "tsc --noEmit && vite build && npm run check:seo && npm run check:i18n",
    "preview": "vite preview --port 4401",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:seo": "opencad-site check-seo",
    "test:seo": "opencad-site test-seo",
    "update:content-dates": "vite build && opencad-site update-content-dates",
    "check:i18n": "opencad-site check-i18n",
    "test:i18n": "vitest run tests/i18n.test.ts",
    "sweep": "vite-node scripts/sweep/sweep.ts --",
    "sweep:compare": "vite-node scripts/sweep/compare.ts --",
    "sim:bench": "vite-node scripts/sim/bench.ts --"
  },
  "dependencies": {
    "opencad-viewer3d": "github:GyuTae-Kim/opencad-viewer3d#v0.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jsdom": "22.1.0",
    "opencad-site-kit": "github:GyuTae-Kim/opencad-site-kit#v0.1.6",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-node": "^5.3.0",
    "vitest": "^4.1.12"
  }
}
