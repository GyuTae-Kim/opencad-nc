{
  "name": "OpenCAD NC 뷰어",
  "short_name": "NC 뷰어",
  "description": "G-code·Heidenhain·woodWOP MPR·WangShi PGI·XML 프로그램을 3D 공구 경로로 보는 무료 NC 뷰어",
  "lang": "ko",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#232830",
  "background_color": "#232830",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            ".nc",
            ".ngc",
            ".gcode",
            ".gco",
            ".gc",
            ".g",
            ".tap",
            ".cnc",
            ".ncc",
            ".nc1",
            ".mpf",
            ".spf",
            ".eia",
            ".iso",
            ".anc",
            ".din",
            ".ptp",
            ".fnc",
            ".min",
            ".hnc",
            ".ncd",
            ".xpi",
            ".cut",
            ".h",
            ".i",
            ".mpr",
            ".pgi",
            ".xml",
            "text/plain",
            "text/x-gcode",
            "application/xml",
            "text/xml",
            "application/octet-stream"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/plain": [
          ".nc",
          ".ngc",
          ".gcode",
          ".gco",
          ".gc",
          ".g",
          ".tap",
          ".cnc",
          ".ncc",
          ".nc1",
          ".mpf",
          ".spf",
          ".eia",
          ".iso",
          ".anc",
          ".din",
          ".ptp",
          ".fnc",
          ".min",
          ".hnc",
          ".ncd",
          ".xpi",
          ".cut",
          ".h",
          ".i",
          ".mpr",
          ".pgi"
        ],
        "application/xml": [
          ".xml"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}
